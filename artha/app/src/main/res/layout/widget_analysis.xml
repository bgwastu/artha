<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_widget_analysis" android:orientation="vertical" android:padding="14dp"
    tools:ignore="HardcodedText">
    <TextView android:id="@+id/widget_month_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="14sp" android:textColor="#F1F0F4" android:textStyle="bold" />
    <TextView android:id="@+id/widget_payment_scope" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Spending to date" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <TextView android:id="@+id/widget_total_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="24sp" android:textColor="#F1F0F4" android:textStyle="bold" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Loading saved payments" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <LinearLayout android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:id="@+id/widget_delta_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <LinearLayout android:id="@+id/widget_categories_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/widget_row_cat1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_cat1_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <TextView android:id="@+id/widget_cat1_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#F1F0F4"  />
</LinearLayout>
    <LinearLayout android:id="@+id/widget_row_cat2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_cat2_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <TextView android:id="@+id/widget_cat2_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#F1F0F4"  />
</LinearLayout>
    <LinearLayout android:id="@+id/widget_row_cat3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_cat3_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#C4C6CF"  />
    <TextView android:id="@+id/widget_cat3_amount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#F1F0F4"  />
</LinearLayout>
</LinearLayout>
</LinearLayout>
    <TextView android:id="@+id/widget_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#C4C6CF" android:visibility="gone" />
</LinearLayout>
