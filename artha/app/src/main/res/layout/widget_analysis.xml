<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_analysis"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <!-- Header: Month Title and Subtle Delta Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="October 2026"
            android:textColor="#E3E2E6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_delta_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="▼ 80% vs last month"
            android:textColor="#C4C6CF"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Total Monthly Spending -->
    <TextView
        android:id="@+id/widget_total_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Rp0"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Thin Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#2C2E33" />

    <!-- Categories List (Matching Spending Analysis) -->
    <LinearLayout
        android:id="@+id/widget_categories_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Category 1 -->
        <LinearLayout
            android:id="@+id/widget_row_cat1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_cat1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Shopping &amp; Hardware"
                android:textColor="#C4C6CF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_cat1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp739.404"
                android:textColor="#E3E2E6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category 2 -->
        <LinearLayout
            android:id="@+id/widget_row_cat2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_cat2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tech &amp; Subscriptions"
                android:textColor="#C4C6CF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_cat2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp63.561"
                android:textColor="#E3E2E6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category 3 -->
        <LinearLayout
            android:id="@+id/widget_row_cat3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_cat3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Transport"
                android:textColor="#C4C6CF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_cat3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp62.300"
                android:textColor="#E3E2E6"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No spending recorded this month"
        android:textColor="#8E9099"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
