<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_transactions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_analysis"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="HardcodedText">

    <!-- Header: Title and Count / Status Pill -->
    <LinearLayout
        android:id="@+id/widget_transactions_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_transactions_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recent Transactions"
            android:textColor="#E3E2E6"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_transactions_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="All Accounts"
            android:textColor="#C4C6CF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Thin Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#2C2E33" />

    <!-- Transactions List -->
    <ListView
        android:id="@+id/widget_transactions_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:nestedScrollingEnabled="true"
        android:scrollbars="none" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_transactions_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No transactions recorded"
        android:textColor="#8E9099"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
